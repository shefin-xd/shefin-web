# Server
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/shefin
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated browser apps allowed to call api.shefin.dev with cookies.
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://auth.shefin.dev,https://admin.shefin.dev,https://chat.shefin.dev
# Leave unset for a host-only API cookie (recommended). Set only if every
# subdomain is trusted to receive the session cookie.
# COOKIE_DOMAIN=.shefin.dev
